# Contact email shown in the footer, sponsor dialog and legal pages. Baked in at build time.
VITE_CONTACT_EMAIL="hello@freebids.lol"

# Public app URL (referral links, ownership checks, OG tags). Must be https:// in production.
APP_URL="http://localhost:3000"

# Supabase Postgres. Run supabase/migrations/001_schema.sql once.
# Only the server talks to the database, with the service role key.
# Leave both unset in local dev to use the JSON file ledger (freebids_db.json).
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
# Force the local JSON ledger even when Supabase is configured.
# DATA_STORE="json"

# Cloudflare Turnstile. A referral visit only counts after the invisible check passes.
# Production refuses to start without the secret. Omit both in local dev to count every visit.
VITE_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET="your-turnstile-secret"
# Salt for hashing visitor IPs (one visit per IP per flag per 3 hours). Any long random string.
VISIT_SALT="any-long-random-string"

# Put new flags on the board immediately, without the ownership check (meta tag or link).
# Use only while seeding the first listings; moderate from /admin.
# SKIP_LISTING_VERIFICATION=true

# Early phase (unset): every flag page view, refresh and outbound click counts as a visit.
# Set to true for the real rules: referral links only, human check, once per visitor/IP per flag every 3 hours.
# STRICT_VISIT_COUNTING=true

# Moderation console (/admin). Production requires a 12+ char password.
ADMIN_USERNAME="operator"
ADMIN_PASSWORD="change-me"

# Product analytics (PostHog). Baked in at build time.
VITE_POSTHOG_KEY="phc_..."
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# DataFast traffic analytics. The header "stats" link uses this public dashboard.
# VITE_DATAFAST_ID="dfid_..."
# VITE_DATAFAST_SHARE_URL="https://datafa.st/share/6ac33b90d07575c1f4ab6134"

# Number of reverse proxies in front of the app. Defaults to 1 (Vercel).
# TRUST_PROXY_HOPS=1
