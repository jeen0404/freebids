{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15,
      "includeFiles": "{public/og-default.png,node_modules/@fontsource/*/files/*-latin-[47]00-normal.woff,node_modules/harfbuzzjs/*.wasm,node_modules/satori/*.wasm,node_modules/@resvg/resvg-js-linux-x64-gnu/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
